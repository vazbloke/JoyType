<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#DD111111"
    android:padding="8dp">

    <com.vazbloke.joytype.VisualDebugView
        android:id="@+id/swipe_debug_view"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:layout_marginBottom="8dp"
        android:visibility="visible" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <HorizontalScrollView
            android:id="@+id/hsv_predictions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:scrollbars="none"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_predictions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:padding="8dp"
                    android:textSize="18sp"
                    android:textColor="#FFFFFF" />

            </LinearLayout>
        </HorizontalScrollView>

        <TextView
            android:id="@+id/tv_mode_badge"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="right|center_vertical"
            android:gravity="center_vertical"
            android:paddingEnd="8dp"
            android:textColor="#AAAAAA" 
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />
        
        <TextView
            android:id="@+id/tv_pagination_badge"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="right|center_vertical"
            android:gravity="center_vertical"
            android:paddingEnd="8dp"
            android:textColor="#888888" 
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

    </FrameLayout>
</LinearLayout>