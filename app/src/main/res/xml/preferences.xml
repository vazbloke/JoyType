<?xml version="1.0" encoding="utf-8"?>
<androidx.preference.PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.preference.PreferenceCategory android:title="Typing Behavior">
        <androidx.preference.SwitchPreferenceCompat
            android:key="autospace_after_accept"
            android:title="Auto-space after Accept (T9 Mode)"
            android:summary="Automatically inserts a space after confirming a word"
            android:defaultValue="true" />
        <androidx.preference.SwitchPreferenceCompat
            android:key="double_accept_period"
            android:title="Double Accept for Period (T9 Mode)"
            android:summary="Double tap the Accept key to insert a period and space"
            android:defaultValue="true" />
        <androidx.preference.SwitchPreferenceCompat
            android:key="auto_capitalization"
            android:title="Auto-Capitalization (T9 Mode)"
            android:summary="Automatically capitalize the first word of a sentence"
            android:defaultValue="true" />
        <SeekBarPreference
            app:key="key_repeat_delay"
            app:title="Key Repeat Delay (ms)"
            app:min="200"
            android:max="1000" 
            app:defaultValue="600"
            app:showSeekBarValue="true" />
    </androidx.preference.PreferenceCategory>

    <androidx.preference.PreferenceCategory android:title="Haptics &amp; Feedback">
        <androidx.preference.DropDownPreference
            android:key="haptic_profile"
            android:title="Haptic Feedback Strength"
            app:useSimpleSummaryProvider="true"
            android:entries="@array/haptic_profile_entries"
            android:entryValues="@array/haptic_profile_values"
            android:defaultValue="MEDIUM" />
    </androidx.preference.PreferenceCategory>

    <androidx.preference.PreferenceCategory android:title="Modifier Keys">
        <com.vazbloke.joytype.LongClickPreference
            android:key="key_mod_1" android:title="Modifier 1 (M1) Key" />
        <com.vazbloke.joytype.LongClickPreference
            android:key="key_mod_2" android:title="Modifier 2 (M2) Key" />
        <com.vazbloke.joytype.LongClickPreference
            android:key="key_mod_3" android:title="Modifier 3 (M3) Key" />
    </androidx.preference.PreferenceCategory>

    <androidx.preference.PreferenceCategory android:title="Joystick Bindings">
        <com.vazbloke.joytype.InlineSpinnerPreference
            android:key="joy_radial_mod"
            android:title="Radial Prediction Selection"
            app:summary="Select the modifier required to open the radial word/special character menu"
            android:defaultValue="M1" />
            
        <com.vazbloke.joytype.InlineSpinnerPreference
            android:key="joy_cursor_mod"
            android:title="Cursor Control"
            app:summary="Select the modifier required to move the text cursor with the analog stick"
            android:defaultValue="M2" />
    </androidx.preference.PreferenceCategory>

    <PreferenceCategory android:title="Key Bindings">
        <com.vazbloke.joytype.KeyBindingPreference
            android:key="key_accept" android:title="Accept Prediction" />
        <com.vazbloke.joytype.KeyBindingPreference
            android:key="key_recompose" android:title="Recompose Accepted Word" />
        <com.vazbloke.joytype.KeyBindingPreference
            android:key="key_backspace_word" android:title="Backspace Entire Stroke / Word" />
        <com.vazbloke.joytype.KeyBindingPreference
            android:key="key_backspace_stroke" android:title="Backspace Active Stroke / Character" />
        <com.vazbloke.joytype.KeyBindingPreference
            android:key="key_add_space" android:title="Add Space" />
        <com.vazbloke.joytype.KeyBindingPreference
            android:key="key_enter" android:title="Enter / Send / Go" />
        <com.vazbloke.joytype.KeyBindingPreference
            android:key="key_undo" android:title="Undo Last Operation" />
        <com.vazbloke.joytype.KeyBindingPreference
            android:key="key_redo" android:title="Redo Undone Operation" />
        <com.vazbloke.joytype.KeyBindingPreference
            android:key="key_cycle_fwd" android:title="Cycle Prediction Forward" />
        <com.vazbloke.joytype.KeyBindingPreference
            android:key="key_cycle_back" android:title="Cycle Prediction Backward" />
        <com.vazbloke.joytype.KeyBindingPreference
            android:key="key_clear_text" android:title="Clear Entire Textbox" />
        <com.vazbloke.joytype.KeyBindingPreference
            android:key="key_toggle_mode" android:title="Toggle Input Mode" />
        <com.vazbloke.joytype.KeyBindingPreference
            android:key="key_add_to_dict" android:title="Add Word to Dictionary" />
        <com.vazbloke.joytype.KeyBindingPreference
            android:key="key_toggle_highlight" android:title="Toggle Highlight Anchor" />
        <com.vazbloke.joytype.KeyBindingPreference
            android:key="key_close" android:title="Close Keyboard" />
        <com.vazbloke.joytype.KeyBindingPreference
            android:key="key_open_settings" android:title="Open Settings" />
    </PreferenceCategory>

    <androidx.preference.PreferenceCategory android:title="Macros">
        <androidx.preference.Preference
            android:key="manage_macros"
            android:title="Manage Macros"
            android:summary="Create, edit, and organize your macro sequences" />
    </androidx.preference.PreferenceCategory>

    <androidx.preference.PreferenceCategory android:title="Experimental">
        <androidx.preference.SwitchPreferenceCompat
            android:key="visual_debug_mode"
            android:title="Visual Debug Mode"
            android:summary="Show the 9-segment grid and joystick trace line"
            android:defaultValue="false" />
            
        <androidx.preference.SwitchPreferenceCompat
            android:key="pair_input_mode"
            android:title="Pair Input Mode"
            android:summary="Allows typing two letters consecutively without returning the joystick fully to the center"
            android:defaultValue="false" />

        <Preference
            android:key="manage_custom_dict"
            android:title="Manage Custom Dictionary"
            android:summary="View, edit, or delete your saved words" />
    </androidx.preference.PreferenceCategory>

</androidx.preference.PreferenceScreen>